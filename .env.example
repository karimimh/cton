SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass_or_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=you@example.com
STARTTLS=true

# Strategy tunables
RSI_PERIOD=14
SWING_K=2
MIN_RSI_LOOKBACK=120
SYMBOL_LIMIT=
REQUEST_TIMEOUT=10
MAX_CANDLES_FETCH=500
TIMEFRAMES=1M,1w,1d,4h
