SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass_or_app_password
EMAIL_FROM=alerts@example.com
EMAIL_TO=you@example.com
STARTTLS=true

# Strategy tunables
RSI_PERIOD=14
SWING_K=2
MIN_RSI_LOOKBACK=120
SYMBOL_LIMIT=
REQUEST_TIMEOUT=10
MAX_CANDLES_FETCH=500
TIMEFRAMES=1M,1w,1d,4h

# Trading bot parameters
TRADE_TIMEFRAME=4h
INITIAL_CAPITAL=1000
ALLOCATION_FRACTION=0.25
MAX_OPEN_TRADES=4
STOP_PCT=5
TARGET_PCT=10
MAX_HOLD_CANDLES=30
ALLOW_SHORTS=false

# Binance API credentials (leave blank for paper mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=
