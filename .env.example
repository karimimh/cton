# Copy to .env and fill in. Never commit your real .env.

# --- Email (SMTP) — required by cton.runner and cton.runner_trading ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASS=your_pass_or_app_password
EMAIL_FROM=alerts@example.com
# Comma-separated list of recipients
EMAIL_TO=you@example.com
STARTTLS=true

# --- Strategy tunables ---
RSI_PERIOD=14
SWING_K=2
MIN_RSI_LOOKBACK=120
# Optional cap on the number of USDC symbols scanned (blank = all)
SYMBOL_LIMIT=
REQUEST_TIMEOUT=10
MAX_CANDLES_FETCH=500
TIMEFRAMES=1M,1w,1d,4h

# --- Trading bot parameters (cton.runner_trading) ---
TRADE_TIMEFRAME=4h
INITIAL_CAPITAL=1000
ALLOCATION_FRACTION=0.25
MAX_OPEN_TRADES=4
STOP_PCT=5
TARGET_PCT=10
MAX_HOLD_CANDLES=30
ALLOW_SHORTS=false

# --- Binance API credentials ---
# Leave BOTH blank to run the trading bot in paper mode (recommended).
# Filling them in sends REAL market orders to Binance spot (api.binance.com);
# there is no testnet routing yet. See README "Known limitations".
BINANCE_API_KEY=
BINANCE_API_SECRET=
